# Backend Configuration
PORT=3000

# PostgreSQL Connection String (Supabase / AWS RDS / Neon)
# e.g. postgresql://postgres.abcdef:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://user:password@localhost:5432/nandhana?schema=public"

# Cryptographic Secrets
# Generate a secure 64-character random string using `openssl rand -hex 32`
JWT_SECRET="replace-this-with-a-very-secure-random-string"
ENCRYPTION_KEY="replace-this-with-a-secure-encryption-key-if-used"

# Admin Seeder Credentials (Used only on initial setup)
ADMIN_EMAIL="admin@securejit.com"
ADMIN_PASSWORD="super-secure-password"

# Frontend Configuration
APP_URL="http://localhost:3000"
